---
import Bilingual from '@/components/Bilingual.astro';
import Icon from '@/components/Icon.astro';
import InkScene from '@/components/InkScene.astro';
import PoemText from '@/components/PoemText.astro';
import ReadingControls from '@/components/ReadingControls.astro';
import SavePoemButton from '@/components/SavePoemButton.astro';
import ScriptText from '@/components/ScriptText.astro';
import BaseLayout from '@/layouts/BaseLayout.astro';
import { formatWrittenDate, getResolvedVisualProfile, loadSiteData, poemPath, type PoemEntry } from '@/lib/site-data';
import { archivePoemAnchor } from '@/lib/archive-navigation';
import '@/styles/archive.css';

export async function getStaticPaths() {
  const { publicPoems } = await loadSiteData();
  return publicPoems.map((poem) => ({ params: { slug: poem.data.slug }, props: { poem } }));
}

interface Props {
  poem: PoemEntry;
}

const { poem } = Astro.props;
const { publicPoems } = await loadSiteData();
const journey = publicPoems;
const index = journey.findIndex((entry) => entry.data.id === poem.data.id);
const previous = index > 0 ? journey[index - 1] : undefined;
const next = index < journey.length - 1 ? journey[index + 1] : undefined;
const visualProfile = getResolvedVisualProfile(poem);
const hasDescriptiveTags = poem.data.descriptiveTags.length > 0;
const year = poem.data.writtenDate.slice(0, 4);
---

<BaseLayout title={poem.data.title} description={`${poem.data.title}，谛深作于 ${formatWrittenDate(poem.data.writtenDate)}。`}>
  <nav class="poem-breadcrumb shell" aria-label="作品位置 / Poem location">
    <ol>
      <li><a href="/archive/"><Bilingual zh="作品档案" en="Archive" /></a></li>
      <li><a href={`/archive/${year}/#${archivePoemAnchor(poem.data.slug)}`}>{year}</a></li>
      <li aria-current="page"><ScriptText text={poem.data.title} originalScript={poem.data.originalScript} /></li>
    </ol>
    <a class="poem-breadcrumb__return" href={`/archive/${year}/#${archivePoemAnchor(poem.data.slug)}`} data-archive-return>← <Bilingual zh={`返回 ${year} 年`} en={`Back to ${year}`} /></a>
  </nav>
  <article class:list={['poem-page', `poem-page--${visualProfile.sceneFamily}`]}>
    <InkScene profile={visualProfile} title={poem.data.title} index={index} />
    <div class:list={['shell', 'poem-page__inner', { 'poem-page__inner--without-note': !hasDescriptiveTags }]}>
      <div class="poem-page__index" aria-hidden="true">
        <span>{String(index + 1).padStart(2, '0')}</span>
        <i></i>
        <small>{String(journey.length).padStart(2, '0')}</small>
      </div>
      <div class="poem-page__card" data-reveal>
        <header>
          <p class="eyebrow"><Bilingual zh="一诗一境" en="One poem · One world" /></p>
          <h1><ScriptText text={poem.data.title} originalScript={poem.data.originalScript} /></h1>
        </header>
        <ReadingControls />
        <PoemText poem={poem} />
        <footer class="poem-page__meta">
          <div>
            <span><ScriptText text="谛深" /></span>
            <time datetime={poem.data.writtenDate}>
              <span data-copy-zh>{formatWrittenDate(poem.data.writtenDate, 'zh')}</span>
              <span data-copy-en>{formatWrittenDate(poem.data.writtenDate, 'en')}</span>
            </time>
          </div>
          <SavePoemButton poem={poem} />
          <div class="poem-page__actions">
            <button class="outline-button" type="button" data-copy-link data-share-url={poemPath(poem)}>
              <Bilingual zh="复制链接" en="Copy link" />
            </button>
            <button class="outline-button" type="button" data-share data-share-title={`${poem.data.title} · 谛深`} data-share-url={poemPath(poem)}>
              <Icon name="share" />
              <Bilingual zh="分享此诗" en="Share" />
            </button>
          </div>
        </footer>
      </div>
      {hasDescriptiveTags && (
        <aside class="poem-page__note">
          <span class="eyebrow"><Bilingual zh="诗中意象" en="Imagery" /></span>
          <ul>
            {poem.data.descriptiveTags.map((tag) => <li><ScriptText text={tag} originalScript={poem.data.originalScript} /></li>)}
          </ul>
        </aside>
      )}
    </div>
  </article>

  <nav class="poem-navigation shell" aria-label="诗歌前后导航 / Adjacent poems">
    {previous ? (
      <a href={poemPath(previous)}>
        <span class="eyebrow"><Bilingual zh="较新一首" en="Newer" /></span>
        <strong><ScriptText text={previous.data.title} originalScript={previous.data.originalScript} /></strong>
      </a>
    ) : <span class="poem-navigation__boundary"><Bilingual zh="已是最新一首" en="Newest poem" /></span>}
    <a class="poem-navigation__archive" href="/archive/">
      <Icon name="archive" />
      <Bilingual zh="时间档案" en="Archive" />
    </a>
    {next ? (
      <a class="poem-navigation__next" href={poemPath(next)}>
        <span class="eyebrow"><Bilingual zh="较早一首" en="Older" /></span>
        <strong><ScriptText text={next.data.title} originalScript={next.data.originalScript} /></strong>
      </a>
    ) : <span class="poem-navigation__boundary poem-navigation__boundary--next"><Bilingual zh="已是最早一首" en="Earliest poem" /></span>}
  </nav>
  <script src="../../scripts/archive-search.ts"></script>
</BaseLayout>

---
import SiteFooter from '@/components/SiteFooter.astro';
import SiteHeader from '@/components/SiteHeader.astro';
import Bilingual from '@/components/Bilingual.astro';
import AudioPlayer from '@/components/AudioPlayer.astro';
import { approvedPlaybackCatalog } from '@/lib/audio-data';
import { ClientRouter } from 'astro:transitions';
import '@/styles/global.css';
import '@fontsource-variable/noto-sans-sc';
import '@fontsource-variable/noto-serif-sc';
import '@/styles/reading.css';

interface Props {
  title?: string;
  description?: string;
  hideChrome?: boolean;
}

const {
  title = '谛深 · 禅诗',
  description = '谛深大师禅诗的公开数字诗集。',
  hideChrome = false,
} = Astro.props;
const pageTitle = title === '谛深 · 禅诗' ? title : `${title} · 谛深禅诗`;
const audioCatalog = approvedPlaybackCatalog();
---

<!doctype html>
<html lang="zh-Hans" data-theme="light" data-language="zh" data-script="simplified" data-reading-size="standard" data-reading-view="wrap">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="google-site-verification" content="_-4F55gPtf1L-6hs6S520k22nrhOWiuR2JdCRhx5vNA" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#f3efe4" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#0d1514" media="(prefers-color-scheme: dark)" />
    <meta name="generator" content={Astro.generator} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <title>{pageTitle}</title>
    <ClientRouter fallback="swap" />
    <script is:inline>
      (() => {
        document.documentElement.classList.add('js');
        const preferredDark = matchMedia('(prefers-color-scheme: dark)').matches;
        document.documentElement.dataset.theme = preferredDark ? 'dark' : 'light';
        try {
          const saved = localStorage.getItem('dishen-theme');
          if (saved === 'light' || saved === 'dark') document.documentElement.dataset.theme = saved;
          const language = localStorage.getItem('dishen-language') === 'en' ? 'en' : 'zh';
          document.documentElement.dataset.language = language;
          const script = localStorage.getItem('dishen-script') === 'traditional' ? 'traditional' : 'simplified';
          document.documentElement.dataset.script = script;
          const size = localStorage.getItem('dishen-reading-size');
          document.documentElement.dataset.readingSize = size === 'small' || size === 'large' ? size : 'standard';
          document.documentElement.dataset.readingView = localStorage.getItem('dishen-reading-view') === 'original' ? 'original' : 'wrap';
          document.documentElement.lang = language === 'en' ? 'en' : script === 'traditional' ? 'zh-Hant' : 'zh-Hans';
        } catch {}
      })();
    </script>
  </head>
  <body>
    <a class="skip-link" href="#main-content"><Bilingual zh="跳至诗文" en="Skip to poem" /></a>
    {!hideChrome && <SiteHeader />}
    <main id="main-content">
      <slot />
    </main>
    {!hideChrome && <SiteFooter />}
    {!hideChrome && audioCatalog.trackIds.length > 0 && <AudioPlayer catalog={audioCatalog} />}
    <div class="share-status" aria-live="polite" aria-atomic="true" data-share-status></div>
    <script src="../scripts/site.ts"></script>
  </body>
</html>
